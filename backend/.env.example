# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_EXPIRATION_MS=86400000

# ── AI Providers (Priority Chain: gemini,cloudflare) ───────────────────────────
AI_PROVIDER=gemini
AI_PROVIDER_CHAIN=gemini,cloudflare

# Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-flash-latest

# Cloudflare Workers AI credentials from https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_HERE
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE

# OpenAI API key from https://platform.openai.com/api-keys (optional)
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
